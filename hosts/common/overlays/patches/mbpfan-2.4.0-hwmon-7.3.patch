From e7a7ecc73d86c8772cba97e4479133e5acf24bb3 Mon Sep 17 00:00:00 2001
From: Charles Menser <charles.menser@gmail.com>
Date: Thu, 8 Oct 2026 20:09:20 -0400
Subject: [PATCH] Support the applesmc hwmon interface from Linux 7.3

Linux 7.3 converts applesmc to hwmon_device_register_with_info()
(commit 94f5081d3592). The fan attributes move from the platform device
into <applesmc device>/hwmon/hwmonN/ and are renamed: fanN_output
becomes fanN_target, and fanN_manual (1/0) becomes pwmN_enable
(1 = manual, 2 = automatic). With that driver mbpfan finds no fans and
exits.

Keep the existing probe first. Fall back to the hwmon files when
fanN_output can't be opened. Each fan records which values its manual
file takes, so the exit path hands control back to the SMC with 2. The
new driver rejects 0 with -EINVAL, which would leave the fans in manual
mode.

Tested on a MacBookPro10,1 with a 7.2.8 kernel that carries 94f5081d3592.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/global.h |  2 ++
 src/mbpfan.c | 61 ++++++++++++++++++++++++++++++++++++++++++++++++----
 2 files changed, 59 insertions(+), 4 deletions(-)

diff --git a/src/global.h b/src/global.h
index 65a22a5..478860f 100644
--- a/src/global.h
+++ b/src/global.h
@@ -23,6 +23,8 @@ struct s_fans {
     char *label;
     char *fan_output_path;
     char *fan_manual_path;
+    int fan_manual_on;  // value written to fan_manual_path to take control
+    int fan_manual_off; // value written to fan_manual_path to hand back to the SMC
     int step_up;
     int step_down;
     int fan_id;
diff --git a/src/mbpfan.c b/src/mbpfan.c
index b45788c..8c8853c 100644
--- a/src/mbpfan.c
+++ b/src/mbpfan.c
@@ -271,6 +271,36 @@ static void trim_trailing_whitespace(char *str)
     }
 }
 
+/*
+ * Newer applesmc drivers register their attributes through the standard hwmon
+ * ABI instead of on the platform device: fan<N>_target replaces fan<N>_output,
+ * and pwm<N>_enable (1 = manual, 2 = automatic) replaces fan<N>_manual (1/0).
+ * Those files live in <applesmc device>/hwmon/hwmon<M>/, not in the device dir.
+ * Returns that directory, or NULL if the device has none.
+ */
+static char *find_applesmc_hwmon_dir()
+{
+    char *hwmon_parent = smprintf("%s/hwmon", applesmc_path);
+    DIR *dir = opendir(hwmon_parent);
+    char *hwmon_dir = NULL;
+
+    if (dir != NULL) {
+        struct dirent *ent;
+
+        while ((ent = readdir(dir)) != NULL) {
+            if (strncmp(ent->d_name, "hwmon", 5) == 0) {
+                hwmon_dir = smprintf("%s/%s", hwmon_parent, ent->d_name);
+                break;
+            }
+        }
+
+        closedir(dir);
+    }
+
+    free(hwmon_parent);
+    return hwmon_dir;
+}
+
 t_fans *retrieve_fans()
 {
     t_fans *fans_head = NULL;
@@ -292,6 +322,8 @@ t_fans *retrieve_fans()
     int counter = 0;
     int fans_found = 0;
 
+    char *hwmon_dir = find_applesmc_hwmon_dir();
+
     for (counter = 0; counter < NUM_FANS; counter++) {
 
         path_output = smprintf("%s%d%s", path_begin, counter, path_output_end);
@@ -301,11 +333,30 @@ t_fans *retrieve_fans()
         path_fan_max = smprintf("%s%d%s", path_begin, counter, path_max_speed);
 
         FILE *file = fopen(path_output, "w");
+        int manual_on = 1;
+        int manual_off = 0;
+
+        if (file == NULL && hwmon_dir != NULL) {
+            free(path_output);
+            free(path_label);
+            free(path_manual);
+            free(path_fan_min);
+            free(path_fan_max);
+            path_output = smprintf("%s/fan%d_target", hwmon_dir, counter);
+            path_label = smprintf("%s/fan%d%s", hwmon_dir, counter, path_label_end);
+            path_manual = smprintf("%s/pwm%d_enable", hwmon_dir, counter);
+            path_fan_min = smprintf("%s/fan%d%s", hwmon_dir, counter, path_min_speed);
+            path_fan_max = smprintf("%s/fan%d%s", hwmon_dir, counter, path_max_speed);
+            manual_off = 2;
+            file = fopen(path_output, "w");
+        }
 
         if (file != NULL) {
             fan = (t_fans *)malloc(sizeof(t_fans));
             fan->fan_output_path = strdup(path_output);
             fan->fan_manual_path = strdup(path_manual);
+            fan->fan_manual_on = manual_on;
+            fan->fan_manual_off = manual_off;
             fan->fan_id = counter;
 
             int fan_speed = read_value(path_fan_min);
@@ -357,6 +408,8 @@ t_fans *retrieve_fans()
         path_manual = NULL;
     }
 
+    free(hwmon_dir);
+
     if (verbose) {
         mbp_log(LOG_INFO, "Found %d fans", fans_found);
     }
@@ -369,7 +422,7 @@ t_fans *retrieve_fans()
     return fans_head;
 }
 
-static void set_fans_mode(t_fans *fans, int mode)
+static void set_fans_mode(t_fans *fans, bool manual)
 {
     t_fans *tmp = fans;
     FILE *file;
@@ -378,7 +431,7 @@ static void set_fans_mode(t_fans *fans, int mode)
         file = fopen(tmp->fan_manual_path, "rw+");
 
         if (file != NULL) {
-            fprintf(file, "%d", mode);
+            fprintf(file, "%d", manual ? tmp->fan_manual_on : tmp->fan_manual_off);
             fclose(file);
         }
 
@@ -389,13 +442,13 @@ static void set_fans_mode(t_fans *fans, int mode)
 void set_fans_man(t_fans *fans)
 {
 
-    set_fans_mode(fans, 1);
+    set_fans_mode(fans, true);
 }
 
 void set_fans_auto(t_fans *fans)
 {
 
-    set_fans_mode(fans, 0);
+    set_fans_mode(fans, false);
 }
 
 t_sensors *refresh_sensors(t_sensors *sensors)
